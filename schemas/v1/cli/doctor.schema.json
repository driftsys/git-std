{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftsys.github.io/git-std/schemas/v1/cli/doctor.schema.json",
  "title": "git std doctor JSON",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "tool_version", "status", "diagnostics", "sections", "hints"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "tool_version": { "type": "string" },
        "status": { "enum": ["pass", "fail"] },
        "diagnostics": { "type": "array" },
        "sections": {
          "type": "object",
          "required": ["status", "hooks", "configuration"]
        },
        "hints": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "required": ["schema_version", "tool_version", "status", "exit_code", "diagnostics"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "tool_version": { "type": "string" },
        "status": { "const": "error" },
        "exit_code": { "type": "integer", "enum": [1, 2] },
        "diagnostics": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": true
    }
  }
}
