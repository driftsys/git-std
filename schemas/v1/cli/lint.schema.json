{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftsys.github.io/git-std/schemas/v1/cli/lint.schema.json",
  "title": "git std lint JSON",
  "oneOf": [
    { "$ref": "#/$defs/result" },
    { "type": "array", "items": { "$ref": "#/$defs/result" } },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "required": ["schema_version", "tool_version", "status", "valid", "errors", "diagnostics"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "tool_version": { "type": "string" },
        "status": { "enum": ["success", "finding"] },
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "diagnostics": { "type": "array" }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["schema_version", "tool_version", "status", "exit_code", "diagnostics"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "tool_version": { "type": "string" },
        "status": { "const": "error" },
        "exit_code": { "type": "integer", "enum": [1, 2] },
        "diagnostics": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": true
    }
  }
}
