{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftsys.github.io/git-std/schemas/v1/cli/version.schema.json",
  "title": "git std version JSON",
  "type": "object",
  "required": ["schema_version", "tool_version", "status"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "tool_version": { "type": "string" },
    "status": { "enum": ["success", "error"] },
    "exit_code": { "type": "integer", "enum": [1, 2] },
    "version": { "type": "string" },
    "describe": { "type": ["string", "null"] },
    "next": { "type": ["string", "null"] },
    "label": { "type": ["string", "null"] },
    "code": { "type": ["integer", "null"] },
    "diagnostics": { "$ref": "#/$defs/diagnostics" }
  },
  "additionalProperties": true,
  "$defs": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "enum": ["error", "warning"] },
          "message": { "type": "string" }
        }
      }
    }
  }
}
