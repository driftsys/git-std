{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftsys.github.io/git-std/schemas/v1/cli/hook-run.schema.json",
  "title": "git std hook run JSON",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema_version", "tool_version", "status", "hook", "commands", "passed", "failed", "advisory_warnings", "skipped"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "tool_version": { "type": "string" },
        "status": { "enum": ["success", "finding"] },
        "hook": { "type": "string" },
        "commands": { "type": "array" },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "advisory_warnings": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "required": ["schema_version", "tool_version", "status", "exit_code", "diagnostics"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "tool_version": { "type": "string" },
        "status": { "const": "error" },
        "exit_code": { "type": "integer", "enum": [1, 2] },
        "diagnostics": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": true
    }
  }
}
