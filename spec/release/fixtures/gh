#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 11 ]]
[[ "$1" == "attestation" ]]
[[ "$2" == "verify" ]]
[[ "$3" == "$EXPECTED_ARCHIVE" ]]
[[ "$4" == "--repo" ]]
[[ "$5" == "driftsys/git-std" ]]
[[ "$6" == "--bundle" ]]
[[ "$7" == "$EXPECTED_ARCHIVE.provenance.sigstore.json" ]]
[[ "$8" == "--signer-workflow" ]]
[[ "$9" == "driftsys/git-std/.github/workflows/release.yml" ]]
[[ "${10}" == "--source-ref" ]]
[[ "${11}" == "${EXPECTED_REF:-refs/tags/v1.2.3}" ]]
printf '%s\n' gh >> "$VERIFIER_LOG"
jq -e --arg ref "${EXPECTED_REF:-refs/tags/v1.2.3}" '.testVerification == "valid" and .testRef == $ref' "$7" >/dev/null
