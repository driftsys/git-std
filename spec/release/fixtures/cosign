#!/usr/bin/env bash
set -euo pipefail

[[ $# -eq 8 ]]
[[ "$1" == "verify-blob" ]]
[[ "$2" == "--bundle" ]]
[[ "$3" == "$EXPECTED_ARCHIVE.sigstore.json" ]]
[[ "$4" == "--certificate-identity" ]]
[[ "$5" == "https://github.com/driftsys/git-std/.github/workflows/release.yml@${EXPECTED_REF:-refs/tags/v1.2.3}" ]]
[[ "$6" == "--certificate-oidc-issuer" ]]
[[ "$7" == "https://token.actions.githubusercontent.com" ]]
[[ "$8" == "$EXPECTED_ARCHIVE" ]]
printf '%s\n' cosign >> "$VERIFIER_LOG"
jq -e --arg ref "${EXPECTED_REF:-refs/tags/v1.2.3}" '.testVerification == "valid" and .testRef == $ref' "$3" >/dev/null
